# InvoiceGuard web app environment variables.
# Copy to .env.local and fill in real values: cp .env.example .env.local
# Never commit .env.local. (.gitignore excludes .env* except this file.)

# Supabase project URL (Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_..., or the legacy anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_..., or the legacy service_role key). Server-only, bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key for invoice field normalization and reviewer-facing explanation.
GROQ_API_KEY=

# Groq model for normalization. Optional, defaults to llama-3.3-70b-versatile when unset.
GROQ_MODEL=

# OCR.space API key for OCR fallback when PDF text is insufficient, and for image invoices.
OCR_SPACE_API_KEY=

# Shared secret protecting POST /api/invoices/process. Must match the PROCESSING_SECRET in n8n.
PROCESSING_SECRET=
